		{
			"name": "GraphQL",
			"description": "Segunda superficie de API sobre el mismo dominio que REST — misma autenticacion JWT, mismos application services por debajo. Ver la seccion GraphQL del README para el por que.",
			"item": [
				{
					"name": "Query — Products (nested category, no N+1)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "query ProductsList($page: Int!, $size: Int!, $activeOnly: Boolean!) {\n  products(page: $page, size: $size, activeOnly: $activeOnly) {\n    totalCount\n    page\n    size\n    items {\n      id\n      sku\n      name\n      category { id name }\n      price\n      stock\n      active\n    }\n  }\n}",
								"variables": "{\n  \"page\": 0,\n  \"size\": 20,\n  \"activeOnly\": true\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "Un solo viaje trae la pagina de productos con su categoria anidada (resuelta por DataLoader en batch — ver ProductNPlusOneGraphQLTest en el backend)."
					},
					"response": []
				},
				{
					"name": "Mutation — Create Category (ADMIN only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation CreateCategory($input: CreateCategoryInput!) {\n  createCategory(input: $input) {\n    id\n    name\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"name\": \"Postman GraphQL Category\"\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "Requiere rol ADMIN — con un token USER o sin token, la respuesta trae un array errors[] no vacio (o 401 si no hay token en absoluto)."
					},
					"response": []
				},
				{
					"name": "Mutation — Create Product (ADMIN only)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{adminToken}}"
							}
						],
						"body": {
							"mode": "graphql",
							"graphql": {
								"query": "mutation CreateProduct($input: CreateProductInput!) {\n  createProduct(input: $input) {\n    id\n    sku\n    name\n    category { id name }\n    price\n  }\n}",
								"variables": "{\n  \"input\": {\n    \"sku\": \"PM-GQL-1\",\n    \"name\": \"Postman GraphQL Product\",\n    \"categoryId\": 1,\n    \"price\": 9.99,\n    \"stock\": 5,\n    \"active\": true\n  }\n}"
							}
						},
						"url": {
							"raw": "{{baseUrl}}/graphql",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"graphql"
							]
						},
						"description": "categoryId debe referenciar una categoria ya existente (usa la que crea el request anterior, o el ID sembrado 1)."
					},
					"response": []
				}
			]
