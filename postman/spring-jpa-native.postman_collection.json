{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-4789-a012-000000000001",
		"name": "spring-jpa-native — Product Service API",
		"description": "Product Service API (Spring MVC + JPA/Hibernate, hexagonal architecture). Uses {{baseUrl}} and a Bearer {{token}} captured automatically from the login requests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Login (admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const status = pm.response.code;",
									"pm.test('Login succeeded (200)', () => pm.expect(status).to.eql(200));",
									"if (status === 200) {",
									"    const body = pm.response.json();",
									"    pm.environment.set('token', body.token);",
									"    pm.test('Token captured', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Logs in as the demo ADMIN user (admin/admin123) and captures the returned JWT into {{token}} via the Tests script."
					}
				},
				{
					"name": "Login (user)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const status = pm.response.code;",
									"pm.test('Login succeeded (200)', () => pm.expect(status).to.eql(200));",
									"if (status === 200) {",
									"    const body = pm.response.json();",
									"    pm.environment.set('token', body.token);",
									"    pm.test('Token captured', () => pm.expect(body.token).to.be.a('string').and.not.empty);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"user\",\n  \"password\": \"user123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Logs in as the demo USER user (user/user123) and captures the returned JWT into {{token}} via the Tests script. Run 'Login (admin)' again afterwards if you need ADMIN-only endpoints (create category, create product, import, update, delete)."
					}
				}
			]
		},
