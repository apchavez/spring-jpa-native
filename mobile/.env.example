# Base URL for the Product Service API backend (see ../api).
# Defaults to http://localhost:8080 if not set - see src/api/client.ts.
#
# - Web preview / iOS simulator / Android emulator on the same machine as the
#   backend: http://localhost:8080 works fine.
# - A physical device running Expo Go: the phone cannot reach "localhost" -
#   use the backend host machine's LAN IP instead, e.g.
#   EXPO_PUBLIC_API_URL=http://192.168.1.50:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
